#!/usr/bin/env python3
"""
Standalone check of how fresh Watercare's own halfhourly data is.

Logs in with the real Watercare API (bypassing Home Assistant entirely) and
reports the gap between the latest halfhourly reading and now, in NZ time.

Usage:
    cp .env.template .env   # fill in your Watercare credentials
    set -a && source .env && set +a
    scripts/check_freshness
"""

import asyncio
import importlib.util
import json
import os
import sys
from datetime import datetime, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo

REPO_ROOT = Path(__file__).resolve().parents[1]

# custom_components/watercare/__init__.py imports homeassistant, which isn't
# installed on the host (only inside the devcontainer) -- load api.py
# directly so this script doesn't need the full HA package just for the
# dependency-free WatercareApi class.
_spec = importlib.util.spec_from_file_location(
    "watercare_api", REPO_ROOT / "custom_components" / "watercare" / "api.py"
)
_module = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_module)
WatercareApi = _module.WatercareApi

NZ_TIMEZONE = ZoneInfo("Pacific/Auckland")


async def main() -> None:
    email = os.environ.get("WATERCARE_EMAIL")
    password = os.environ.get("WATERCARE_PASSWORD")
    if not email or not password:
        print("Set WATERCARE_EMAIL and WATERCARE_PASSWORD (see .env.template).")
        sys.exit(1)

    api = WatercareApi(email, password)

    today = datetime.now(NZ_TIMEZONE).date()
    start_date = (today - timedelta(days=7)).strftime("%Y-%m-%d")
    end_date = today.strftime("%Y-%m-%d")

    print(f"Requesting halfhourly data from {start_date} to {end_date}...")
    response = await api.get_data("halfhourly", start_date, end_date)
    if response is None:
        print("Got no response from the API (check credentials/logs above).")
        sys.exit(1)

    readings = json.loads(response)
    if not readings:
        print("API returned an empty reading list.")
        sys.exit(1)

    readings.sort(key=lambda r: r["timestamp"])
    latest = readings[-1]
    latest_ts = (
        datetime.strptime(latest["timestamp"], "%Y-%m-%dT%H:%M:%S.%fZ")
        .replace(tzinfo=ZoneInfo("UTC"))
        .astimezone(NZ_TIMEZONE)
    )

    now = datetime.now(NZ_TIMEZONE)
    lag = now - latest_ts

    print(f"Total readings fetched: {len(readings)}")
    print(f"Latest reading timestamp (NZ time): {latest_ts.isoformat()}")
    print(f"Now (NZ time):                      {now.isoformat()}")
    print(f"Lag between latest reading and now: {lag}")


if __name__ == "__main__":
    asyncio.run(main())
